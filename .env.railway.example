# Copy this file to .env.railway on each lab PC and fill in the allocated
# Railway TCP proxy endpoints and SASL credentials. Never commit .env.railway.
KAFKA_HOST=<KAFKA_TCP_PROXY_HOST>
KAFKA_PORT=<KAFKA_TCP_PROXY_PUBLIC_PORT>
CENTRAL_HOST=<CENTRAL_TCP_PROXY_HOST>
CENTRAL_PORT=<CENTRAL_TCP_PROXY_PUBLIC_PORT>

KAFKA_REQUIRE_SECURITY=true
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=<GENERATED_KAFKA_USERNAME>
KAFKA_SASL_PASSWORD=<GENERATED_KAFKA_PASSWORD>

# Local certificate file on this PC; copy the public CA certificate here.
KAFKA_CA_CERT_PATH=./secrets/railway-kafka-ca.pem
# Path inside all Railway-connected application containers.
KAFKA_SSL_CA_LOCATION=/run/secrets/kafka/ca.pem
KAFKA_SSL_CA_PEM=

# Optional station/operator configuration for this PC.
WS1_LOCAL_OPERATOR_ID=OP_002
WS2_LOCAL_OPERATOR_ID=OP_003
FO_OPERATOR_ID=OP_001
