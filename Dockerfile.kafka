# Compile the startup certificate verifier with a JDK; the Apache Kafka runtime
# image intentionally remains a JRE-only image.
FROM eclipse-temurin:21-jdk AS cert-verifier-build
COPY scripts/VerifyKafkaCertificate.java /src/VerifyKafkaCertificate.java
RUN javac -d /classes /src/VerifyKafkaCertificate.java

# Fail-closed Railway Kafka 3.8.0 image. Local Compose intentionally uses the
# upstream PLAINTEXT image instead.
FROM apache/kafka:3.8.0

COPY config/kafka/server.railway.properties /mnt/shared/config/server.properties
COPY scripts/kafka-railway-entrypoint.sh /opt/wm/kafka-railway-entrypoint.sh
COPY --from=cert-verifier-build /classes/VerifyKafkaCertificate.class /opt/wm/VerifyKafkaCertificate.class
USER root
RUN chmod 0755 /opt/wm/kafka-railway-entrypoint.sh
USER appuser
CMD ["/opt/wm/kafka-railway-entrypoint.sh"]
